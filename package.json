{
  "name": "fragments",
  "private": true,
  "version": "0.0.1",
  "description": "Authenticated REST API for storing and converting text, JSON, and image fragments with AWS persistence",
  "scripts": {
    "test": "jest -c jest.config.js --runInBand --",
    "lint": "eslint \"./src/**/*.js\" \"tests/**/*.js\"",
    "start": "node src/index.js",
    "dev": "nodemon ./src/index.js --watch src",
    "debug": "nodemon --inspect=0.0.0.0:9229 ./src/index.js --watch src",
    "test:watch": "jest -c jest.config.js --runInBand --watch --",
    "coverage": "jest -c jest.config.js --runInBand --coverage",
    "test:integration": "hurl --test --glob \"tests/integration/**/*.hurl\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ken-2004/fragments.git"
  },
  "author": "Harsh Prajapati",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@orangeopensource/hurl": "^8.0.2",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "htpasswd": "^2.4.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0",
    "aws-jwt-verify": "^5.1.1",
    "compression": "^1.8.1",
    "content-type": "^1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "html-to-text": "^10.0.0",
    "http-auth": "^4.2.1",
    "http-auth-passport": "^1.0.7",
    "markdown-it": "^14.3.0",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "stoppable": "^1.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
